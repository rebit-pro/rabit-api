# =============================================================================
# Docker Compose Environment
# Скопируй в .env и заполни реальными значениями: cp .env.example .env
# =============================================================================

# --- MySQL ---
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=secrets
MYSQL_ROOT_PASSWORD=rootpassword

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- API ---
APP_DEBUG=1
# Xdebug в dev-образах выключен по умолчанию. Для отладки: XDEBUG_MODE=debug,develop и пересоздать контейнеры.
# api-php-cli (composer, тесты) всегда работает с XDEBUG_MODE=off.
XDEBUG_MODE=off
APP_ENV=local
REBIT_TOKEN_TTL_HOURS=24
REBIT_AUTH_REGISTRATION_CODE_TTL_MINUTES=15
REBIT_AUTH_REGISTRATION_RESEND_COOLDOWN_SECONDS=60
REBIT_AUTH_REGISTRATION_MAX_ATTEMPTS=5
REBIT_AUTH_MAIL_EVENT_SITE_ID=s1
REBIT_SMTP_HOST=mailpit
REBIT_SMTP_PORT=1025
REBIT_SMTP_ENCRYPTION=none
REBIT_SMTP_USERNAME=
REBIT_SMTP_PASSWORD=
REBIT_SMTP_FROM_EMAIL=noreply@rebit-p2p.loc
REBIT_SMTP_FROM_NAME="RaBit API"
REBIT_SMTP_TLS_CERTCHECK=off

# Общий Telegram-клиент rebit.share для заявок с сайта и внешних лидов LeadHunter.
# В production токен берётся из Docker Swarm secret rebit_telegram_bot_token
# (см. deploy/secrets/README.md). Локально runtime читает api/public/.env.
REBIT_NOTIFICATION_TELEGRAM_BOT_TOKEN=
REBIT_NOTIFICATION_TELEGRAM_CHAT_ID=
# Адрес Bot API можно заменить на HTTPS-релей при недоступном api.telegram.org.
REBIT_NOTIFICATION_TELEGRAM_API_URL=https://api.telegram.org
# Прокси cURL, например socks5h://user:pass@host:port или http://user:pass@host:port.
REBIT_NOTIFICATION_TELEGRAM_PROXY=

# K3: бот MAX для вопросов кураторам. Токен в production — Docker secret rebit_max_bot_token.
REBIT_NOTIFICATION_MAX_BOT_TOKEN=
REBIT_NOTIFICATION_MAX_API_URL=https://platform-api2.max.ru
# Путь к Russian Trusted Root CA; по умолчанию файл из rebit.notification/resources/max.
#REBIT_NOTIFICATION_MAX_CA_FILE=
# ID закрытой группы кураторов (отрицательное число, см. app:support:max-status); 0 — вопросы копятся в pending.
MOREFOTO_SUPPORT_MAX_CHAT_ID=0
# Секрет подписки webhook [A-Za-z0-9_-]{32,256}; в production — Docker secret morefoto_support_max_webhook_secret.
MOREFOTO_SUPPORT_MAX_WEBHOOK_SECRET=

# Приём заявок с сайта (rebit.notification, POST /api/v1/lead).
# Доставка синхронная: Telegram, затем email при сбое, если резерв настроен.
REBIT_NOTIFICATION_LEAD_MAX_FILE_MB=15
# Если пусто/не задано, резервный email берётся из REBIT_LEADHUNTER_FALLBACK_EMAIL.
#REBIT_NOTIFICATION_LEAD_FALLBACK_EMAIL=

# Прямая email-доставка для формы mos-dizel.ru (POST /api/v1/lead/mos-dizel).
# Получатель задаётся только на сервере и не принимается из HTTP-запроса.
#REBIT_NOTIFICATION_MOS_DIZEL_EMAIL=

# Охота за лидами (rebit.leadhunter): мониторинг внешних площадок → Telegram.
# Правила — JSON: source (площадка), params (параметры ленты), keywords
# (пустой список = брать весь раздел). Для fl.ru раздел «Сайты под ключ» =
# category=2, subcategory=27. Токен/прокси Telegram общие (REBIT_NOTIFICATION_*).
REBIT_LEADHUNTER_RULES='[{"source":"flRu","keywords":["битрикс","bitrix"]},{"source":"flRu","params":{"category":2,"subcategory":27},"keywords":[]}]'
# По умолчанию используется REBIT_NOTIFICATION_TELEGRAM_CHAT_ID;
# отдельный чат — раскомментировать:
#REBIT_LEADHUNTER_TELEGRAM_CHAT_ID=
# Переопределение URL ленты fl.ru (для тестов/зеркала):
#REBIT_LEADHUNTER_FLRU_RSS_URL=https://www.fl.ru/rss/all.xml
# Резервная доставка письмом сразу, как только Telegram не ответил.
# Пусто = резерв выключен:
#REBIT_LEADHUNTER_FALLBACK_EMAIL=

# Оплата MoreFoto через ЮKassa (morefoto.payment, G1). Пусто = оплата выключена.
# Секретный ключ в production — Docker Swarm secret morefoto_yookassa_secret_key (deploy/secrets/README.md).
# Тестовый магазин принимает только bank_card; боевой — sbp,bank_card (порядок = порядок кнопок).
MOREFOTO_PAYMENT_YOOKASSA_SHOP_ID=
MOREFOTO_PAYMENT_YOOKASSA_SECRET_KEY=
MOREFOTO_PAYMENT_METHODS=bank_card
# Адрес frontend для возврата со страницы оплаты (в production — https), без личного ключа заказа.
MOREFOTO_PAYMENT_RETURN_BASE_URL=

REBIT_GEETEST_ENABLED=0
REBIT_GEETEST_BYPASS=1
REBIT_GEETEST_CAPTCHA_ID=
REBIT_GEETEST_CAPTCHA_KEY=
REBIT_GEETEST_API_URL=https://gcaptcha4.geetest.com

# --- RabbitMQ ---
RABBITMQ_USER=rebit
RABBITMQ_PASSWORD=rebit
RABBITMQ_VHOST=rebit
RABBITMQ_EXTERNAL_PORT=5672
RABBITMQ_MANAGEMENT_EXTERNAL_PORT=15672
# Dev: пароль напрямую. Production: использовать __RABBITMQ_PASSWORD__ — подставится из Docker secret.
MESSENGER_TRANSPORT_DSN=amqp://rebit:rebit@rabbitmq:5672/rebit

# --- Local Docker / Traefik ---
# Существующий локальный alias и сертификат оставлены для совместимости.
TRAEFIK_CERT_PATH=/home/user/traefik/certs/rebit-p2p.loc.pem

# =============================================================================
# Production / Deploy (для make build, make push, make deploy)
# =============================================================================

# --- Docker Registry ---
REGISTRY=ghcr.io/rebit-pro
IMAGE_TAG=latest

# --- Docker Registry Auth (для docker login на сервере) ---
REGISTRY_HOST=ghcr.io
REGISTRY_USER=
TOKEN_GIT_HUB=

# --- Deploy Target ---
HOST=
PORT=22
DEPLOY_USER=deploy
BUILD_NUMBER=

# --- Swarm ---
STACK_NAME=rabit-api

# W04: volume names are explicit and external; Compose never provisions them.
# For an existing installation, copy names from its inspected mounts.
# For a NEW installation only, provision these names deliberately before compose up.
MYSQL_VOLUME_NAME=rabit-api_api-mysql
RABBITMQ_VOLUME_NAME=rabit-api_rabbitmq-data
# Production: set the EXISTING directory and separate cron config; no default relocation.
RUNTIME_DATA_DIR=
CRON_ENV_CONFIG_NAME=
AUDIT_CONSUMER_REPLICAS=0
# D1: отдельный consumer приватных оригиналов; 0 временно отключает обработку.
MEDIA_CONSUMER_REPLICAS=1
