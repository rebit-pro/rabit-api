# General
/xxx
/.vscode
/.idea
.env

# PHP
**.php-cs-fixer.cache
**.htaccess
**test.php

# Dumps
/dump.sql.7z
/dump.sql.7z:Zone.Identifier

# Logs
/logs/
/api/logs/*
!/api/logs/.gitkeep
!/api/logs/logstash/
/api/logs/logstash/*
!/api/logs/logstash/.gitkeep

# API
**/vendor/
/api/var/*
!/api/var/.gitkeep
/api/tcp
/api/log/
/api/public/bitrix/
/api/public/upload/
/api/public/include/
/api/public/local/routes/*
